* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: Arial, sans-serif;
}

body {
    background-color: #f0f0f0;
    text-align: center;
    padding: 20px;
}

h1 {
    margin-bottom: 20px;
    color: #333;
}

.unit {
    margin-bottom: 15px;
    border: 1px solid #ccc;
    border-radius: 5px;
    background-color: white;
    padding: 10px;
    cursor: pointer;
}

.unit h2 {
    background-color: #007bff;
    color: white;
    padding: 10px;
    border-radius: 5px;
    margin: 0;
}

.unit-content {
    display: none;
    padding: 10px;
}

.unit-content a {
    display: block;
    text-decoration: none;
    color: #007bff;
    font-weight: bold;
    margin: 5px 0;
}

.unit-content a:hover {
    text-decoration: underline;
}

/* Player Page Styles */
#player-container {
    max-width: 800px;
    margin: 20px auto;
    padding: 20px;
    background: white;
    box-shadow: 0px 4px 10px rgba(0, 0, 0, 0.1);
    border-radius: 8px;
    text-align: center;
}

iframe {
    width: 100%;
    height: 400px;
    border: none;
    border-radius: 6px;
    background: black;
}

.player-buttons {
    margin-top: 20px;
}

.btn {
    display: inline-block;
    padding: 10px 20px;
    margin: 5px;
    background-color: #007bff;
    color: white;
    text-decoration: none;
    border-radius: 5px;
}

.btn:hover {
    background-color: #0056b3;
}
